# Copia este archivo a ".env" (en esta misma carpeta) y completa los valores
# reales para probar el backend en tu computador. En Render, estas mismas
# variables se configuran en el panel de la web (Environment), NO en este
# archivo — .env nunca se sube al repositorio.

# Cadena de conexión que te da Neon al crear el proyecto/base de datos.
DATABASE_URL=postgresql://usuario:clave@host.neon.tech/nombre_basedatos?sslmode=require

# Usuario y hash de la clave para entrar a la app (genera el hash con:
# node scripts/generar_hash_clave.js "tu-clave").
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=

# Cadena aleatoria larga para firmar las sesiones. Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Dominio(s) desde donde se puede llamar a esta API (separados por coma si
# son varios). El sitio publicado en GitHub Pages, y opcionalmente uno local
# para pruebas.
ALLOWED_ORIGIN=https://filleral.github.io,http://127.0.0.1:5500

# Puerto local (Render lo define solo con su propia variable PORT).
PORT=3000
